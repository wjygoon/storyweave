<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Secrets.plist - API 密钥配置（请勿提交到 git）
  
  =====================================================
  【国内用户推荐配置】
  =====================================================
  文本生成：DeepSeek V3（国产最强，国内直连，¥1/百万token）
    → https://platform.deepseek.com/ 注册获取 API Key
  
  图像生成：火山引擎/豆包（字节跳动，国内直连）
    → https://console.volcengine.com/ark/ 创建推理接入点
  
  =====================================================
  【海外用户推荐配置】
  =====================================================
  文本生成：Google Gemini（需要科学上网）
    → https://aistudio.google.com/ 获取 API Key
  
  图像生成：OpenAI DALL-E 3（需要科学上网）
    → https://platform.openai.com/ 获取 API Key
  
  =====================================================
  【代理配置】
  =====================================================
  如果在海外环境但想用国内服务：无需配置
  
  如果在大陆环境想用海外服务：
    Xcode 里运行时配置代理（Settings → Network → 代理）
    或在 App 设置里填写 Clash/V2Ray 代理地址
-->
<plist version="1.0">
<dict>
    <!-- ============= 国内 Provider（推荐大陆用户） ============= -->
    
    <!-- DeepSeek V3 - 文本生成（首选） -->
    <key>DEEPSEEK_API_KEY</key>
    <string>sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx</string>
    
    <!-- 火山引擎/豆包 - 文本+图像 -->
    <key>ARK_API_KEY</key>
    <string>xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx</string>
    <key>ARK_TEXT_ENDPOINT</key>
    <string>ep-xxxxxxxxxxxxxxxx-xxxxx</string>
    <key>ARK_IMAGE_ENDPOINT</key>
    <string>ep-xxxxxxxxxxxxxxxx-xxxxx</string>
    
    <!-- 阿里通义（可选） -->
    <key>QWEN_API_KEY</key>
    <string></string>
    
    <!-- MiniMax（可选） -->
    <key>MINIMAX_API_KEY</key>
    <string></string>
    
    <!-- ============= 海外 Provider ============= -->
    
    <!-- Google Gemini - 文本生成 -->
    <key>GEMINI_API_KEY</key>
    <string>YOUR_GEMINI_API_KEY_HERE</string>
    
    <!-- OpenAI DALL-E - 图像生成 -->
    <key>OPENAI_API_KEY</key>
    <string>YOUR_OPENAI_API_KEY_HERE</string>
    
    <!-- ============= Supabase 云端同步（可选） ============= -->
    <key>SUPABASE_URL</key>
    <string>YOUR_SUPABASE_URL_HERE</string>
    <key>SUPABASE_ANON_KEY</key>
    <string>YOUR_SUPABASE_ANON_KEY_HERE</string>
</dict>
</plist>
